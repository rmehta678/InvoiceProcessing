# Obtain this credential from xAI. Never commit a real value.
XAI_API_KEY=

# Local state paths. Databases must be created explicitly with the db commands.
INVOICE_INVENTORY_DB=inventory.db
INVOICE_WORKFLOW_DB=workflow.db
# Required for cross-database human-decision atomicity. PERSIST, TRUNCATE, and WAL fail closed.
INVOICE_SQLITE_JOURNAL_MODE=DELETE

# Business policy; changing this requires business-owner review.
INVOICE_REVIEW_THRESHOLD_AMOUNT=10000.00
INVOICE_REVIEW_THRESHOLD_CURRENCY=USD
INVOICE_REVIEW_THRESHOLD_EFFECTIVE_DATE=2026-08-06

# Business policy; changing this requires business-owner review.
# Maximum absolute distance, in calendar days, between the stated due date and
# invoice_date + Net-N payment terms before the case requires human review
# (covers inclusive-counting and weekend conventions).
INVOICE_DUE_DATE_TOLERANCE_DAYS=3

# Operational circuit breakers. Exhaustion results in INCOMPLETE, not success.
INVOICE_MAX_MESSAGES=40
INVOICE_MODEL_TIMEOUT_SECONDS=120
INVOICE_TRANSIENT_RETRIES=2
INVOICE_CASE_CONCURRENCY=2

# Required in addition to --allow-remote-i-understand for any non-loopback UI bind.
# Use exact bare browser host names only; wildcards, schemes, and ports are rejected.
INVOICE_UI_ALLOWED_HOSTS=[]

# Web console display only: pending reviews older than this many hours get an
# amber accent in the queue. Never changes review behavior.
INVOICE_REVIEW_AGE_AMBER_HOURS=24
