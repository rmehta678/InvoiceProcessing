# Copy to .env and fill in your key(s). .env is gitignored -- never commit it.
#
#   cp .env.example .env
#
# A real environment variable overrides anything set here.

# --- Primary provider: xAI Grok (the case study's stated reasoning engine) ---
# Get a key at https://console.x.ai -- note the account also needs credits.
XAI_API_KEY=xai-your-key-here

# Optional: override the Grok model (default: grok-3)
# INVOICE_FLOW_MODEL=grok-3

# --- Fallback provider: OpenRouter ---
# Used only when xAI cannot serve at all: no key, a rejected key, an unfunded
# account, or a sustained outage. Leave unset to run xAI-only.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# The pipeline needs tool calling AND structured output; many models have
# neither. Default is a free model that supports both.
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Model-level reasoning depth: low | medium | high | default
# Low by default. This pipeline supplies its own reasoning structure (the
# extraction repair loop and the VP/audit critique cycle); an unconstrained
# reasoning model spends its whole output budget thinking and gets truncated
# mid-JSON. Use "default" to leave the model's own setting alone.
# OPENROUTER_REASONING_EFFORT=low
